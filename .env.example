# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Neon: use the direct, non-pooled endpoint for drizzle-kit push)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# JWT signing secret, required, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Optional: API port for local dev (defaults to 8080)
# PORT=8080
