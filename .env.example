# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Neon: use the direct, non-pooled endpoint for drizzle-kit push)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# JWT signing secret: a long random string
SESSION_SECRET=replace-with-a-long-random-string

# Optional: API port for local dev (defaults to 8080)
# PORT=8080
