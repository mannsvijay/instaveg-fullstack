# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Neon: use the direct, non-pooled endpoint for drizzle-kit push)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# JWT signing secret, required, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Optional: API port for local dev (defaults to 8080)
# PORT=8080

# Optional: origins allowed to call the API cross-origin, comma-separated.
# Leave unset when the frontend is served from the same origin as /api.
# CORS_ORIGINS=https://example.com,https://www.example.com

# Optional: rate limit for POST /auth/login (failed attempts only) and
# POST /auth/register, per IP. Defaults: 10 per 15 minutes.
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_MS=900000
